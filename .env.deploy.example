# Deployment identity. This repository is deployment-neutral: no account id,
# hostname or resource id is tracked in git, so nothing here has an upstream
# default to inherit — every instance fills this in itself.
#
#   cp .env.deploy.example .env.deploy
#   bun run bootstrap        # creates D1/KV/R2 on your account, fills the ids
#   bun run config:gen       # renders wrangler.jsonc + generated app config
#
# Any key can instead come from the environment (CI variables win over this
# file). Only BU_-prefixed variables are read. Secrets never live here:
#   cd apps/server && bunx wrangler secret put BETTER_AUTH_SECRET
#   ... R2_SECRET_ACCESS_KEY, INSTALL_TOKEN_SECRET, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_SECRET

# --- Required ---------------------------------------------------------------
# Generation fails without these; they identify one specific deployment.
BU_CF_ACCOUNT_ID=
# Dashboard + API origin, no scheme.
BU_APP_HOST=updates.example.com
# Verified sender for invitation email (Cloudflare Email Routing).
BU_EMAIL_SENDER=noreply@example.com
# Origin OTA assets are served from — an R2 custom domain on your zone, NOT the
# Worker (there is no /assets/* route on the API origin). Point it at the public
# domain you attach to the assets bucket.
BU_ASSET_CDN_HOST=assets.example.com
# Filled in by `bun run bootstrap`.
BU_D1_DATABASE_ID=
BU_KV_SESSION_ID=
BU_KV_BUILD_RESERVATIONS_ID=

# --- Optional: hostnames ----------------------------------------------------
# Zone owning BU_APP_HOST. Empty ⇒ no routes + workers.dev (API-only; the
# dashboard needs a zone, see docs/self-hosting.md).
BU_CF_ZONE_ID=
# Isolated origin for the env-vault unlock UI. Empty ⇒ that origin is disabled.
BU_VAULT_HOST=

# --- Optional: resource names (generic defaults shown) ----------------------
BU_SERVER_WORKER_NAME=better-update-server
BU_WEB_WORKER_NAME=better-update-web
BU_D1_DATABASE_NAME=better-update
BU_R2_ASSETS_BUCKET=better-update-assets
BU_R2_BUILDS_BUCKET=better-update-builds
BU_R2_CREDENTIALS_BUCKET=better-update-credentials
# Analytics Engine datasets. Writes need no token; READING them back needs a
# CLOUDFLARE_API_TOKEN worker secret with Account Analytics Read (see
# docs/self-hosting.md).
BU_ANALYTICS_DATASET=update_events
BU_DELIVERY_ANALYTICS_DATASET=delivery_events

# --- Optional: application --------------------------------------------------
# Access key ID of the R2 token used to presign uploads; the secret half goes
# through `wrangler secret put R2_SECRET_ACCESS_KEY`.
BU_R2_ACCESS_KEY_ID=
# Contact address on the legal pages. Empty ⇒ falls back to BU_EMAIL_SENDER.
BU_LEGAL_EMAIL=
# Comma-separated emails auto-promoted to superadmin on first sign-in.
BU_SUPERADMIN_EMAILS=
# Non-secret OAuth client ids. Empty ⇒ that provider is disabled.
BU_GITHUB_CLIENT_ID=
BU_GOOGLE_CLIENT_ID=
