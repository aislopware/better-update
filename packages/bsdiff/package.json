{
  "name": "@better-update/bsdiff",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "src/magic.ts"
  ],
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./magic": "./src/magic.ts"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "test": "vitest run",
    "test:conformance": "node conformance/run-conformance.mjs"
  },
  "devDependencies": {
    "@better-update/oxlint-config": "workspace:*",
    "@better-update/typescript-config": "workspace:*",
    "@napi-rs/cli": "^3.9.1"
  },
  "napi": {
    "binaryName": "bsdiff",
    "packageName": "@better-update/bsdiff",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
