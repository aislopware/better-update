{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@lerna-lite/version",
        "@tanstack/react-query",
        "@tanstack/react-router",
        "conventional-changelog-conventionalcommits",
        "kysely",
        "type-fest"
      ]
    },
    "apps/server": {
      "entry": [
        "cloudflare.config.ts",
        "src/index.ts",
        "src/app-layer.ts",
        "src/infrastructure-layer.ts"
      ],
      "project": ["*.ts", "src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/web": {
      "entry": ["cloudflare.config.ts"],
      "project": ["*.ts", "src/**/*.{ts,tsx,css}", "tests/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["tests/interactive/harness/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["expo", "@effect/platform-node-shared"],
      "ignoreBinaries": ["openssl", "keytool", "ditto"]
    },
    "packages/api": {
      "project": ["src/**/*.ts"]
    },
    "packages/api-client": {
      "project": ["src/**/*.ts"]
    },
    "packages/react-hooks": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/components/**/*.tsx", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/bsdiff": {
      "ignore": ["oxlint.config.mjs"],
      "ignoreDependencies": ["@better-update/bsdiff-.+"],
      "ignoreUnresolved": ["\\./bsdiff\\."]
    }
  },
  "ignoreDependencies": ["@better-update/oxlint-config"],
  "ignoreWorkspaces": ["packages/oxlint-config", "packages/typescript-config"],
  "ignoreExportsUsedInFile": true,
  "ignore": ["fixtures/**"]
}
