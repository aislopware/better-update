{
  "name": "better-update",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bun scripts/bootstrap-cloudflare.ts",
    "build": "turbo run build",
    "check": "turbo run lint:check format:check",
    "d1:migrate": "turbo run d1:migrate",
    "dev": "turbo run dev",
    "dev:proxy": "portless proxy start",
    "dev:proxy:stop": "portless proxy stop",
    "dev:trust": "portless trust",
    "fix": "turbo run lint format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "prepare": "lefthook install --force",
    "release:preview": "lerna version --conventional-commits --dry-run",
    "release:version": "lerna version --conventional-commits --yes --no-push",
    "test": "turbo run test",
    "test:all": "bun run test && bun run test:integrations && bun run test:e2e",
    "test:e2e": "turbo run test:e2e",
    "test:integrations": "turbo run test:integrations",
    "typegen:cf": "turbo run typegen:cf",
    "ui:gen": "bun scripts/gen-kumo-passthrough.ts",
    "verify": "node scripts/self-verify.mjs",
    "verify:e2e": "node scripts/self-verify.mjs --only=e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "kysely": "^0.29.7"
  },
  "devDependencies": {
    "@better-update/deploy-config": "workspace:*",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "4.1.0",
    "@lerna-lite/cli": "^5.6.4",
    "@lerna-lite/version": "^5.6.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-beta.26",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "knip": "^6.44.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-eslint": "1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "portless": "^0.15.12",
    "turbo": "^2.11.10",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "kysely": "0.29.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    }
  },
  "patchedDependencies": {
    "@tanstack/router-core@1.171.39": "patches/@tanstack%2Frouter-core@1.171.39.patch"
  }
}
