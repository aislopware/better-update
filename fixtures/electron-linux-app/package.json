{
  "name": "example-electron-linux",
  "version": "1.0.0",
  "private": true,
  "description": "An Electron app that updates itself from a better-update Linux feed (slow e2e fixture).",
  "homepage": "https://example.com",
  "author": "Example Developer <dev@example.com>",
  "main": "main.js",
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.example.electronlinux",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Example Developer <dev@example.com>"
    },
    "files": [
      "main.js",
      "payload.bin"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost/unused"
      }
    ]
  },
  "productName": "Example Electron"
}
