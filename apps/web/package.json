{
  "name": "@better-update/web",
  "version": "0.75.0",
  "private": true,
  "description": "Better Update web app (accounts + console) on Cloudflare Workers",
  "homepage": "https://github.com/better-update/better-update",
  "repository": {
    "type": "git",
    "url": "https://github.com/better-update/better-update.git",
    "directory": "apps/web"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "config:gen": "bun ../../scripts/gen-config.ts",
    "config:gen:strict": "bun ../../scripts/gen-config.ts --strict",
    "deploy": "bun run config:gen:strict && vite build && wrangler deploy",
    "dev": "bun run config:gen && PORTLESS=1 portless better-update vite dev",
    "dev:local": "bun run config:gen && vite dev",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "pretest:e2e": "bunx playwright install chromium",
    "preview": "vite preview",
    "test": "vitest run --project unit --project component",
    "test:all": "bun run test && bun run test:e2e",
    "test:e2e": "vitest run --project e2e-api --project e2e-browser --retry 2",
    "test:e2e:api": "vitest run --project e2e-api --retry 2",
    "test:e2e:browser": "vitest run --project e2e-browser --retry 2",
    "test:e2e:ci": "vitest run --project e2e-api --project e2e-browser --retry 1 --bail 1",
    "typegen:cf": "bun run config:gen && wrangler types"
  },
  "dependencies": {
    "@better-update/api": "workspace:*",
    "@better-update/api-client": "workspace:*",
    "@better-update/auth-client": "workspace:*",
    "@better-update/credentials-crypto": "workspace:*",
    "@better-update/encoding": "workspace:*",
    "@better-update/expo-protocol": "workspace:*",
    "@better-update/react-hooks": "workspace:*",
    "@better-update/safe-json": "workspace:*",
    "@better-update/type-guards": "workspace:*",
    "@better-update/ui": "workspace:*",
    "@cloudflare/kumo": "^2.9.2",
    "@cloudflare/vite-plugin": "^1.51.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-spring/web": "^10.1.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.40",
    "@tanstack/react-table": "^9.1.0",
    "@tanstack/zod-adapter": "^1.167.0",
    "cobe": "^2.0.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "effect": "^3.22.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-update/oxlint-config": "workspace:*",
    "@better-update/typescript-config": "workspace:*",
    "@rsbuild/core": "^2.1.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "agent-react-devtools": "^0.4.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "react-devtools-core": "^7.0.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
