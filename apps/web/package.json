{
  "name": "@better-update/web",
  "version": "0.88.1",
  "private": true,
  "description": "Better Update web app (accounts + console) on Cloudflare Workers",
  "homepage": "https://github.com/aislopware/better-update",
  "repository": {
    "type": "git",
    "url": "https://github.com/aislopware/better-update.git",
    "directory": "apps/web"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "BU_DEPLOY_STRICT=1 vite build && cf deploy --prebuilt --mode production",
    "dev": "PORTLESS=1 portless better-update vite dev",
    "dev:local": "vite dev",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "pretest:e2e": "bunx playwright install chromium",
    "preview": "vite preview",
    "test": "vitest run --project unit --project component",
    "test:all": "bun run test && bun run test:e2e",
    "test:e2e": "vitest run --project e2e-api --project e2e-browser --retry 2",
    "test:e2e:api": "vitest run --project e2e-api --retry 2",
    "test:e2e:browser": "vitest run --project e2e-browser --retry 2",
    "test:e2e:ci": "vitest run --project e2e-api --project e2e-browser --retry 1 --bail 1",
    "typegen:cf": "cf workers types"
  },
  "dependencies": {
    "@better-update/api": "workspace:*",
    "@better-update/api-client": "workspace:*",
    "@better-update/auth-client": "workspace:*",
    "@better-update/credentials-crypto": "workspace:*",
    "@better-update/encoding": "workspace:*",
    "@better-update/expo-protocol": "workspace:*",
    "@better-update/react-hooks": "workspace:*",
    "@better-update/safe-json": "workspace:*",
    "@better-update/type-guards": "workspace:*",
    "@better-update/ui": "workspace:*",
    "@cloudflare/kumo": "^2.16.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^14.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/zod-adapter": "^1.167.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "effect": "4.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-update/deploy-config": "workspace:*",
    "@better-update/oxlint-config": "workspace:*",
    "@better-update/typescript-config": "workspace:*",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "agent-react-devtools": "^0.5.0",
    "cf": "1.0.0-beta.26",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.152.0",
    "playwright": "^1.64.1",
    "react-devtools-core": "^8.0.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
