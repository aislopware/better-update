{
  "name": "@better-update/server",
  "version": "0.70.0",
  "private": true,
  "description": "Better Update API server on Cloudflare Workers",
  "homepage": "https://github.com/aislopware/better-update",
  "repository": {
    "type": "git",
    "url": "https://github.com/aislopware/better-update.git",
    "directory": "apps/server"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "d1:codegen": "bun scripts/db-codegen.ts",
    "d1:migrate": "bun scripts/d1-migrate.ts",
    "d1:migrate:remote": "bun scripts/d1-migrate.ts --remote",
    "deploy": "BU_DEPLOY_STRICT=1 vite build && cf deploy --prebuilt --mode production",
    "dev": "PORTLESS=1 portless server.better-update vite dev",
    "dev:local": "vite dev",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "preview": "vite preview",
    "seed:dev": "bun scripts/seed-dev.ts",
    "test": "vitest run --project unit --coverage",
    "test:all": "bun run test && bun run test:integrations && bun run test:e2e",
    "test:e2e": "bun run test:e2e-pool && bun run test:e2e-r2",
    "test:e2e-pool": "vitest run --project e2e-pool",
    "test:e2e-r2": "bash scripts/e2e-r2.sh",
    "test:integrations": "vitest run --project integration --maxWorkers 1 --fileParallelism false",
    "test:watch": "vitest --project unit",
    "typegen:cf": "cf workers types"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.14",
    "@better-update/api": "workspace:*",
    "@better-update/dotenv": "workspace:*",
    "@better-update/encoding": "workspace:*",
    "@better-update/expo-codesign": "workspace:*",
    "@better-update/expo-protocol": "workspace:*",
    "@better-update/safe-json": "workspace:*",
    "@better-update/type-guards": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@xmldom/xmldom": "^0.9.12",
    "better-auth": "^1.7.14",
    "effect": "4.1.0",
    "es-toolkit": "^1.53.0",
    "kysely": "^0.29.7",
    "s3mini": "^1.0.3",
    "structured-headers": "^2.1.1"
  },
  "devDependencies": {
    "@better-update/deploy-config": "workspace:*",
    "@better-update/oxlint-config": "workspace:*",
    "@better-update/typescript-config": "workspace:*",
    "@cloudflare/config": "0.29.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@vitest/coverage-istanbul": "^5.0.5",
    "cf": "1.0.0-beta.26",
    "kysely-bun-sqlite": "^0.4.0",
    "kysely-codegen": "^0.20.0",
    "vite": "^8.3.5",
    "wrangler": "4.156.0"
  }
}
