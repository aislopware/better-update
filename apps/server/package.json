{
  "name": "@better-update/server",
  "version": "0.61.0",
  "private": true,
  "description": "Better Update API server on Cloudflare Workers",
  "homepage": "https://github.com/better-update/better-update",
  "repository": {
    "type": "git",
    "url": "https://github.com/better-update/better-update.git",
    "directory": "apps/server"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "config:gen": "bun ../../scripts/gen-config.ts",
    "config:gen:strict": "bun ../../scripts/gen-config.ts --strict",
    "d1:codegen": "bun scripts/db-codegen.ts",
    "d1:migrate": "bun run config:gen && wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "bun run config:gen:strict && wrangler d1 migrations apply DB --remote",
    "deploy": "bun run config:gen:strict && vite build && wrangler deploy",
    "dev": "bun run config:gen && PORTLESS=1 portless server.better-update vite dev",
    "dev:local": "bun run config:gen && vite dev",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "preview": "vite preview",
    "seed:dev": "bun scripts/seed-dev.ts",
    "test": "vitest run --project unit --coverage",
    "test:all": "bun run test && bun run test:integrations && bun run test:e2e",
    "test:e2e": "bun run test:e2e-pool && bun run test:e2e-r2",
    "test:e2e-pool": "vitest run --project e2e-pool",
    "test:e2e-r2": "bash scripts/e2e-r2.sh",
    "test:integrations": "vitest run --project integration --maxWorkers 1 --fileParallelism false",
    "test:watch": "vitest --project unit",
    "typegen:cf": "bun run config:gen && wrangler types"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.25",
    "@better-update/api": "workspace:*",
    "@better-update/dotenv": "workspace:*",
    "@better-update/encoding": "workspace:*",
    "@better-update/expo-codesign": "workspace:*",
    "@better-update/expo-protocol": "workspace:*",
    "@better-update/safe-json": "workspace:*",
    "@better-update/type-guards": "workspace:*",
    "@effect/platform": "^0.97.1",
    "@noble/hashes": "^2.2.0",
    "@xmldom/xmldom": "^0.9.10",
    "better-auth": "^1.6.25",
    "effect": "^3.22.1",
    "es-toolkit": "^1.50.0",
    "kysely": "^0.29.4",
    "s3mini": "^0.9.5",
    "structured-headers": "^2.0.3"
  },
  "devDependencies": {
    "@better-update/oxlint-config": "workspace:*",
    "@better-update/typescript-config": "workspace:*",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "kysely-bun-sqlite": "^0.4.0",
    "kysely-codegen": "^0.20.0",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
