#!/bin/sh
# Launcher for the @better-update/cli npm package.
#
# The CLI is a standalone binary shipped in one @better-update/cli-<platform>
# optional dependency per os/cpu/libc; the package manager installs only the
# matching one. This script execs that binary, so running the command needs
# neither Node nor Bun and no postinstall step (which global installs of npm ≥ 11
# and bun skip by default anyway).
set -eu

self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
pkg="$(cd "$(dirname "$self")/.." && pwd)"

os="$(uname -s)"
arch="$(uname -m)"
case "$os" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
esac
case "$arch" in
  arm64 | aarch64) arch=arm64 ;;
  x86_64 | amd64) arch=x64 ;;
esac
libc=""
if [ "$os" = linux ]; then
  if ls /lib/ld-musl-* >/dev/null 2>&1 || (ldd --version 2>&1 | grep -qi musl); then
    libc="-musl"
  fi
fi
platform="cli-$os-$arch$libc"

# npm nests dependencies under the package; bun/pnpm hoist them as siblings.
for candidate in \
  "$pkg/node_modules/@better-update/$platform/better-update" \
  "$pkg/../$platform/better-update"; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

echo "better-update: no prebuilt binary for $os-$arch$libc was installed (package @better-update/$platform)." >&2
echo "Re-run the install with optional dependencies enabled, or install the binary directly:" >&2
echo "  curl -fsSL https://raw.githubusercontent.com/aislopware/better-update/main/install.sh | sh" >&2
exit 1
