{
  "name": "@better-update/cli",
  "version": "0.88.1",
  "private": true,
  "description": "The better-update CLI, shipped as a `bun build --compile` single binary (see scripts/build.ts).",
  "homepage": "https://github.com/aislopware/better-update",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aislopware/better-update.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "dev": "bun src/index.ts",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "pretest:e2e": "bun scripts/build.ts",
    "pretest:integrations": "bun scripts/build.ts",
    "pretest:interactive": "bun scripts/build.ts",
    "pretest:slow": "bun scripts/build.ts",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e --maxWorkers 1 --fileParallelism false",
    "test:integrations": "vitest run --project integration",
    "test:interactive": "vitest run --project interactive --maxWorkers 1 --fileParallelism false",
    "test:slow": "vitest run --project slow --maxWorkers 1 --fileParallelism false",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@better-update/bsdiff": "workspace:*",
    "@effect/platform-bun": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "@expo/apple-utils": "^2.2.1",
    "@expo/config": "^58.0.9",
    "@expo/config-plugins": "~58.0.11",
    "@expo/pkcs12": "^0.7.2",
    "@expo/plist": "^0.10.1",
    "@expo/xcpretty": "^4.4.7",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "bplist-parser": "^0.5.0",
    "chalk": "^6.0.1",
    "effect": "4.1.0",
    "es-toolkit": "^1.53.0",
    "gradle-to-js": "^2.0.1",
    "ignore": "^7.0.14",
    "node-forge": "^1.4.2",
    "qrcode-terminal": "^0.12.0",
    "xcode": "^4.0.0",
    "xz-decompress": "^0.2.3"
  },
  "devDependencies": {
    "@better-update/api": "workspace:*",
    "@better-update/credentials-crypto": "workspace:*",
    "@better-update/deploy-config": "workspace:*",
    "@better-update/encoding": "workspace:*",
    "@better-update/expo-codesign": "workspace:*",
    "@better-update/expo-protocol": "workspace:*",
    "@better-update/oxlint-config": "workspace:*",
    "@better-update/safe-json": "workspace:*",
    "@better-update/type-guards": "workspace:*",
    "@better-update/typescript-config": "workspace:*",
    "@effect/platform-node": "4.1.0",
    "@types/bun": "^1.4.4",
    "@types/node-forge": "^1.3.14",
    "@types/xcode": "^3.0.0",
    "node-pty": "^1.1.0"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
